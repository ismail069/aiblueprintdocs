{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AI Blueprint Help Centre",
  "description": "Customer guides for turning an app idea into a reviewed, development-ready blueprint.",
  "colors": { "primary": "#2D5BDF", "light": "#4B7BFF", "dark": "#5075F5" },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          { "group": "Get started", "pages": ["index", "quickstart", "walkthrough", "concepts/blueprint-lifecycle"] },
          { "group": "Review and revise", "pages": ["guides/statuses-and-approval", "guides/revise-with-assistant", "guides/versions-and-rollback", "guides/project-zip-and-coding-agent"] },
          { "group": "Credits and account", "pages": ["guides/free-tier", "guides/credits-and-billing", "account/settings-and-security", "account/support"] },
          { "group": "Reference", "pages": ["reference/output-documents"] },
          { "group": "Troubleshooting", "pages": ["troubleshooting/generation", "troubleshooting/login-and-payments"] }
        ]
      },
      {
        "language": "id",
        "navbar": {
          "links": [{ "label": "Support", "href": "https://www.aiblueprint.web.id/support" }],
          "primary": { "type": "button", "label": "Buka workspace", "href": "https://www.aiblueprint.web.id/dashboard" }
        },
        "groups": [
          { "group": "Mulai", "pages": ["id/index", "id/quickstart", "id/walkthrough", "id/konsep/alur-blueprint"] },
          { "group": "Tinjau dan revisi", "pages": ["id/panduan/status-dan-approval", "id/panduan/revisi-assistant", "id/panduan/versi-dan-rollback", "id/panduan/project-zip-dan-coding-agent"] },
          { "group": "Kredit dan akun", "pages": ["id/panduan/free-tier", "id/panduan/kredit-dan-billing", "id/akun/pengaturan-keamanan", "id/akun/support"] },
          { "group": "Referensi", "pages": ["id/referensi/dokumen-output"] },
          { "group": "Troubleshooting", "pages": ["id/troubleshooting/generasi", "id/troubleshooting/login-dan-pembayaran"] }
        ]
      }
    ],
    "global": {
      "anchors": [
        { "anchor": "AI Blueprint", "href": "https://www.aiblueprint.web.id", "icon": "house" },
        { "anchor": "Support", "href": "https://www.aiblueprint.web.id/support", "icon": "life-ring" }
      ]
    }
  },
  "logo": { "light": "/logo/light.svg", "dark": "/logo/dark.svg" },
  "navbar": {
    "links": [{ "label": "Support", "href": "https://www.aiblueprint.web.id/support" }],
    "primary": { "type": "button", "label": "Open workspace", "href": "https://www.aiblueprint.web.id/dashboard" }
  },
  "contextual": { "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"] },
  "footer": { "socials": { "github": "https://github.com/ismail069/aiblueprintdocs" } }
}
